{
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "scripts": {
    "client": "cd needyhelp-ui && npm start",
    "server": "cd needyHelpBackend && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-server": "npm install --prefix needyHelpBackend",
    "install-client": "npm install --prefix needyhelp-ui",
    "install": "npm run install-server && npm run install-client",
    "test": "cd needyhelp-ui && npm test"
  }
}
